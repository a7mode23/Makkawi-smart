# قالب إعدادات سكربتات التشغيل — انسخه إلى ops/inventory.local.env وعدّله
#
#   cp ops/inventory.example.env ops/inventory.local.env
#
# ⛔ ops/inventory.local.env مُستثنى في .gitignore ولا يُرفع إلى GitHub.

# رابط اللوحة (لفحص الاستجابة)
WASEL_URL="https://panel.example.com"

# الدومين (لفحص انتهاء شهادة SSL)
WASEL_DOMAIN="panel.example.com"

# مسار التطبيق على السيرفر (افتراضيًا: مجلد المستودع)
# WASEL_APP_DIR="/var/www/wasel"

# مجلد النسخ الاحتياطية
WASEL_BACKUP_DIR="/var/backups/wasel"

# أقصى عمر مقبول لآخر نسخة احتياطية بالساعات قبل التحذير
WASEL_BACKUP_MAX_AGE_HOURS="26"

# خدمات النظام التي يجب أن تكون شغالة (مفصولة بمسافة)
WASEL_SERVICES="nginx php8.1-fpm"

# حد التحذير لامتلاء القرص (نسبة مئوية)
WASEL_DISK_WARN_PCT="80"

# مهلة فحص منفذ API للراوتر (ثوانٍ)
WASEL_ROUTER_TIMEOUT="5"
